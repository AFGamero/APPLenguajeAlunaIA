# ============================================================
# Nebbi API — Variables de entorno
# Copia este archivo como .env y completa los valores
# ============================================================

# Base de datos — Neon PostgreSQL
# Obtén esta URL desde: neon.tech → tu proyecto → Connection Details
DATABASE_URL=postgresql://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/nebbi?sslmode=require

# JWT — Genera una clave segura con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-segura-de-64-caracteres-generada-con-secrets
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS — URL del frontend en Vercel
FRONTEND_URL=https://app-lenguaje-aluna-ia-3w1t.vercel.app
