# ============================================================
# Kogui App — Variables de entorno
# ============================================================
# Copia este archivo como .env.local y rellena los valores.
# NUNCA comitas .env.local al repositorio.
# ============================================================

# ── FastAPI Backend ──────────────────────────────────────────
# Local: http://localhost:8000
# Railway: https://tu-backend.up.railway.app
VITE_API_URL=http://localhost:8000

# ── Feature flags ────────────────────────────────────────────
# Mantener en false hasta migrar el panel admin a FastAPI.
VITE_ENABLE_ADMIN=false

# ── Vercel (opcional, solo para referencia) ──────────────────
# Configura estas mismas variables en:
# Vercel Dashboard → Project → Settings → Environment Variables
# VITE_API_URL=...
# VITE_ENABLE_ADMIN=false
