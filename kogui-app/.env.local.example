# ============================================================
# Kogui App — Variables de entorno
# ============================================================
# Copia este archivo como .env.local y rellena los valores.
# NUNCA comitas .env.local al repositorio.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Encuéntralas en: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://<tu-proyecto>.supabase.co
VITE_SUPABASE_ANON_KEY=<tu-anon-key>

# ── Vercel (opcional, solo para referencia) ──────────────────
# Configura estas mismas variables en:
# Vercel Dashboard → Project → Settings → Environment Variables
# VITE_SUPABASE_URL=...
# VITE_SUPABASE_ANON_KEY=...
